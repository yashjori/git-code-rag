# Copy to .env.local for local development. Vite bakes VITE_-prefixed vars
# in at build time - a built bundle must be redeployed to point elsewhere.
VITE_API_BASE_URL=http://localhost:8000

# Vercel deploy: set to "/" so API calls stay same-origin and frontend/vercel.json
# proxies /api/* to the Render backend (keeps the session cookie first-party).

# Hide the private-repo token field on deployments not served over HTTPS.
VITE_ENABLE_PRIVATE_TOKENS=true
