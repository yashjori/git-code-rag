# --------------------------------------------------------------------------
# Git Repository Code Assistant - environment configuration
#
# Copy this file to .env and fill in real values. Never commit .env.
# --------------------------------------------------------------------------

APP_NAME=Git Repository Code Assistant
APP_ENV=development
LOG_LEVEL=INFO
# Comma-separated origins the frontend is served from.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Session auth ------------------------------------------------------------
# Signs session cookies. MUST be a real random value (32+ chars) in any
# non-local deployment - generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# A weak or shared key lets anyone forge a valid session.
AUTH_SECRET_KEY=
AUTH_SESSION_DAYS=7
# true in any deployment served over HTTPS (the browser silently drops a
# Secure cookie sent over plain HTTP, so this must be false for local dev).
COOKIE_SECURE=false

# --- Groq LLM (generation only, never used for embeddings) -----------------
# Model name is read from config, never hardcoded. Groq's available models
# change over time and can differ per account - check
# https://api.groq.com/openai/v1/models with your key (or
# console.groq.com/docs/models) rather than trusting an example here.
# openai/gpt-oss-120b was confirmed available as of 2026-09-23.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Git provider credentials -----------------------------------------------
# Only needed for private repositories. Never logged, never returned in
# API responses, never persisted in repository metadata.
GITHUB_TOKEN=
AZURE_DEVOPS_PAT=

# --- Qdrant Cloud (hosted vector database + hosted embedding inference) ----
# Embeddings and vector storage both run on Qdrant Cloud. No local
# HuggingFace/Sentence-Transformers model is loaded in this process.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=code_chunks
# Must be a model exposed by Qdrant Cloud Inference on your cluster
# (see the Inference tab of the cluster in the Qdrant Cloud console).
# sentence-transformers/all-minilm-l6-v2 is on the Qdrant Cloud free tier.
QDRANT_EMBEDDING_MODEL=sentence-transformers/all-minilm-l6-v2
# Vector size for the model above. Qdrant Cloud Inference does not expose
# this programmatically - read it from the Inference tab of your cluster in
# the Qdrant Cloud console and set it here so the collection is created
# with the correct vector dimensionality. 384 matches
# sentence-transformers/all-minilm-l6-v2.
QDRANT_EMBEDDING_DIMENSION=384

# --- Local repository processing --------------------------------------------
# Git clone, file scanning, filtering and chunking happen on this machine.
# Only text chunks are sent to Qdrant Cloud for embedding.
REPOSITORY_STORAGE_DIRECTORY=./data/repositories
REPOSITORY_METADATA_DB_PATH=./data/repositories.db

CHUNK_SIZE=1500
CHUNK_OVERLAP=200
RETRIEVAL_TOP_K=8
MAX_INDEX_FILE_SIZE_KB=512
